<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>ai.storyteller.vectorcraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>VectorCraft</name>
  <summary>Draw and edit vector illustrations, SVG and PDF</summary>
  <summary xml:lang="ru">Рисование и редактирование векторных иллюстраций, SVG и PDF</summary>
  <developer id="ai.storyteller">
    <name>Learning Machines LLC</name>
  </developer>
  <description>
    <p>
      VectorCraft is an open-source vector illustration app. Draw with pen, shape and brush tools,
      style art with fills, strokes, gradients and live effects, lay out artboards and type, and
      open and save SVG and PDF.
    </p>
    <p xml:lang="ru">
      VectorCraft — открытое приложение для векторной иллюстрации. Рисуйте пером, фигурами
      и кистями, оформляйте графику заливками, обводками, градиентами и динамическими
      эффектами, размещайте монтажные области и текст, открывайте и сохраняйте SVG и PDF.
    </p>
  </description>
  <launchable type="desktop-id">ai.storyteller.vectorcraft.desktop</launchable>
  <icon type="stock">ai.storyteller.vectorcraft</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://getartcraft.com/apps/vectorcraft</url>
  <url type="bugtracker">https://github.com/storytold/vectorcraft/issues</url>
  <url type="help">https://github.com/storytold/vectorcraft</url>
  <url type="contact">https://discord.gg/artcraft</url>
  <categories>
    <category>Graphics</category>
    <category>2DGraphics</category>
    <category>VectorGraphics</category>
  </categories>
  <keywords>
    <keyword>vector</keyword>
    <keyword xml:lang="ru">вектор</keyword>
    <keyword>illustration</keyword>
    <keyword xml:lang="ru">иллюстрация</keyword>
    <keyword>svg</keyword>
    <keyword xml:lang="ru">svg</keyword>
    <keyword>pdf</keyword>
    <keyword xml:lang="ru">pdf</keyword>
    <keyword>drawing</keyword>
    <keyword xml:lang="ru">рисование</keyword>
    <keyword>bezier</keyword>
    <keyword xml:lang="ru">безье</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>Editing the Neon Drive poster with a live glow effect in the Appearance panel</caption>
      <caption xml:lang="ru">Редактирование постера Neon Drive с динамическим эффектом свечения на панели «Оформление»</caption>
      <image>https://raw.githubusercontent.com/storytold/vectorcraft/main/docs/images/shot-1-neon.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>vectorcraft</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
