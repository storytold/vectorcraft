# Apache (see HOSTING.md). Needs mod_mime; mod_deflate and mod_headers are optional.
AddType application/wasm .wasm
AddType font/ttf .ttf
AddType text/javascript .js

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/wasm text/javascript text/html font/ttf
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^vectorcraft-web-.*\.(wasm|js)$|\.ttf$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|vectorcraft-plugin-worker.*)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
