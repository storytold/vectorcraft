<?xml version="1.0" encoding="utf-8"?>
<!--
  Vector W3K2 MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build vectorcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut and an App Paths entry (so
  `vectorcraft` starts from the Run dialog), plus vectorcraft-cli.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Vector W3K2"
      Manufacturer="Print That 204"
      Version="$(var.Version)"
      UpgradeCode="69F97515-36D2-4056-87AA-A4197564296D"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Vector W3K2 vector illustration app" Manufacturer="Print That 204" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Vector W3K2 is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="VectorcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="VectorcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://printthat.ca" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/printthat204-bot/vectorcraft" />
    <Property Id="ARPHELPLINK" Value="https://printthat.ca" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Vector W3K2" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Vector W3K2" Level="1">
      <ComponentGroupRef Id="VectorcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="VectorcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="VectorcraftApp" Guid="8332A2F7-E48E-48F3-8807-95AEBBBCDEF3">
        <File Id="VectorcraftExe" Source="$(var.BinDir)\vectorcraft.exe" Name="Vector W3K2.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Vector W3K2"
              Description="Vector W3K2 vector illustration app" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="VectorcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\Vector W3K2.exe" Value="[#VectorcraftExe]" Type="string" />
      </Component>

      <Component Id="VectorcraftCli">
        <File Id="VectorcraftCliExe" Source="$(var.BinDir)\vectorcraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
