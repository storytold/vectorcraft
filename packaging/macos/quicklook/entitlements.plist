<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements of the Quick Look extensions (VectorCraftThumbnail.appex, VectorCraftPreview.appex).
     App extensions must be sandboxed (unlike the app, ../entitlements.plist). They only read the
     file Quick Look hands them, which the sandbox lets them open; the read-only file access is
     the least that covers it. No network, no writes. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-only</key>
  <true/>
</dict>
</plist>
